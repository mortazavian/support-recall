# The browser UI is published on this host interface and port.
SUPPORTRECALL_BIND=127.0.0.1
SUPPORTRECALL_PORT=8080

# Container paths for persisted uploads and Chroma vectors.
SUPPORTRECALL_UPLOADS_DIR=/app/uploads
SUPPORTRECALL_VECTOR_DIR=/app/vectors

# Local Ollama host URL for Compose; source imports need this service to index data.
OLLAMA_BASE_URL=http://host.docker.internal:11434
SUPPORTRECALL_EMBEDDING_MODEL=embeddinggemma:latest
