# The browser UI is published on this host interface and port.
SUPPORTRECALL_BIND=127.0.0.1
SUPPORTRECALL_PORT=8080

# Container path for persisted original uploads; keep aligned with the Compose volume.
SUPPORTRECALL_UPLOADS_DIR=/app/uploads

# Reserved for later model integration; source import does not require Ollama.
OLLAMA_BASE_URL=http://host.docker.internal:11434
